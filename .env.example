# Explicitly use demo only for development/UAT with a separate demo database.
# Missing APP_MODE defaults to production, except NODE_ENV=development.
APP_MODE=demo
# Ignored in production, even if set to true.
DEMO_ROLE_SWITCHER=true
DEMO_NETWORK_SIMULATOR=true
DEMO_INBOUND_BOOKINGS=true
# Optional DEMO inbound-provider secret. This endpoint is disabled in production.
INBOUND_BOOKING_SECRET=

# Production identity adapter: disabled until a trusted authentication gateway is configured.
# Set AUTH_PROVIDER=trusted-hosting only after completing docs/production-foundation.md.
AUTH_PROVIDER=disabled
# Server/gateway-only shared random secret (at least 32 characters). Never NEXT_PUBLIC_*.
# Gateway strips incoming identity/proof headers and injects verified identity + this proof.
AUTH_TRUSTED_PROXY_SECRET=

# Production PostgreSQL connection. Use a server-only connection string.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/hotel_management
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10
NEXT_PUBLIC_SITE_URL=http://localhost:3000
