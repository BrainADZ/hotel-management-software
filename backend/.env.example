# Explicitly use demo only for development/UAT with a separate demo database.
# Missing APP_MODE defaults to production, except NODE_ENV=development.
APP_MODE=demo

# Ignored in production, even if set to true.
DEMO_ROLE_SWITCHER=true
DEMO_NETWORK_SIMULATOR=true
DEMO_INBOUND_BOOKINGS=true

# Optional DEMO inbound-provider secret.
# This endpoint is disabled in production.
INBOUND_BOOKING_SECRET=

# Production identity adapter:
# disabled until a trusted authentication gateway is configured.
# Set AUTH_PROVIDER=trusted-hosting only after completing
# docs/production-foundation.md.
AUTH_PROVIDER=disabled

# Server/gateway-only shared random secret (at least 32 characters).
# Never expose this through NEXT_PUBLIC_*.
AUTH_TRUSTED_PROXY_SECRET=

# Explicit localhost production authentication.
# Keep disabled in hosted production unless intentionally required.
LOCAL_AUTH_ENABLED=false

# For HTTPS production this should remain true.
# For localhost HTTP development, actual backend/.env may use false.
LOCAL_AUTH_COOKIE_SECURE=true

# Local/demo bootstrap administrator.
# Do NOT reuse these credentials for a real production deployment.
LOCAL_ADMIN_EMAIL=web@brainadz.marketing
LOCAL_ADMIN_PASSWORD=admin@HMS

# Keep false by default.
# Enable only in controlled demo/local environments.
SHOW_DEMO_CREDENTIALS=false

# Optional Google OpenID Connect.
# Secrets remain server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Persistent local development uploads.
# Hosted production should use private object storage.
AVATAR_STORAGE_DIR=./data/avatars

# PostgreSQL connection.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/hotel_management
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10

# Hotel Management backend
PORT=4000
HOST=127.0.0.1

# Hotel Management frontend runs on port 3001.
# This avoids a conflict with other local frontend projects using port 3000.
FRONTEND_ORIGINS=http://localhost:3001

# Demo data storage
DEMO_DATA_DIR=./data