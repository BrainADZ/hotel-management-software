{
  "name": "hotel-management-software",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:migrate": "npm run db:migrate -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:seed-local": "npm run db:seed-local -w backend"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "@types/node": "22.19.19",
    "concurrently": "^9.2.0"
  }
}
